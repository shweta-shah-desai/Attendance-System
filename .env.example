# GharSaathi+ environment configuration — template.
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
# Every EXPO_PUBLIC_* var is inlined into the JS bundle at build time, so
# nothing here may ever be a secret.

EXPO_PUBLIC_APP_NAME=GharSaathi+
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_CURRENCY=INR
EXPO_PUBLIC_DEFAULT_REMINDER_TIME=20:00

# Supabase (Phase 0). Settings -> API in the Supabase dashboard.
# The anon key is a public identifier, safe to ship ONLY because RLS is
# enabled on every table (Phase 1). The service_role key must NEVER appear
# in this app — it bypasses RLS entirely.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
